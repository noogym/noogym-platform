FROM node:22-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PNPM_CONFIG_FETCH_RETRIES=5
ENV PNPM_CONFIG_FETCH_TIMEOUT=600000
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

FROM base AS deps
RUN apk add --no-cache libc6-compat
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile

FROM base AS web-builder
ENV NEXT_OUTPUT_STANDALONE=true
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
RUN pnpm --filter @noogym/marketing build

FROM base AS api-builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
RUN pnpm --filter @noogym/leads-api build

FROM base AS web-runner
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=web-builder --chown=nextjs:nodejs /app/apps/marketing/public ./apps/marketing/public
COPY --from=web-builder --chown=nextjs:nodejs /app/apps/marketing/.next/standalone ./
COPY --from=web-builder --chown=nextjs:nodejs /app/apps/marketing/.next/static ./apps/marketing/.next/static

USER nextjs
EXPOSE 3000

CMD ["node", "apps/marketing/server.js"]

FROM base AS api-runner
RUN apk add --no-cache libc6-compat openssl

ENV NODE_ENV=production
ENV PORT=3333

COPY --from=api-builder /app/node_modules ./node_modules
COPY --from=api-builder /app/apps/leads-api/node_modules ./apps/leads-api/node_modules
COPY --from=api-builder /app/apps/leads-api/dist ./apps/leads-api/dist
COPY --from=api-builder /app/apps/leads-api/prisma ./apps/leads-api/prisma
COPY --from=api-builder /app/apps/leads-api/package.json ./apps/leads-api/package.json
COPY --from=api-builder /app/packages ./packages

EXPOSE 3333

CMD ["sh", "-c", "./apps/leads-api/node_modules/.bin/prisma migrate deploy --schema apps/leads-api/prisma/schema.prisma && node apps/leads-api/dist/main.js"]
